# ==============================================================================
# Constructor Backend - Environment Variables Template
# Copy this file to `.env` (never commit `.env`!) and fill in real values.
# ==============================================================================

# Active Spring profile: dev | staging | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8078
API_URL=http://localhost:8078

# PostgreSQL Database
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=postgres
POSTGRESQL_SCHEMA=constructor
POSTGRESQL_USER=postgres
POSTGRESQL_PASS=change_me

# JWT RSA Keys (PEM string with \n or file:/path/to/key.pem)
# In `dev` profile, if left empty, ephemeral keys are generated in .dev-certs/
# In `staging` and `prod`, BOTH keys are strictly required.
JWT_EXPIRED_MINUTES=60
JWT_REFRESH_EXPIRED_DAYS=7
JWT_ISSUER=constructor-backend
JWT_COOKIE_SECURE=false
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Login Rate Limiting & Brute-force Protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_MINUTES=5

# SMTP Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password

# Cloudinary Object Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Initial Admin Seed (optional in staging/prod; if password blank, admin seed is skipped)
ADMIN_INITIAL_USERNAME=admin@gmail.com
ADMIN_INITIAL_PASSWORD=
